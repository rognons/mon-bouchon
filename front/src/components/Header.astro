---
---

<header class="hero-header">
	<div class="hero-container">
		<div class="logo">
			<img 
				src="/logo-compagnie-image-text-black.png" 
				alt="Logo La Compagnie du Rognon" 
				class="logo-image"
			>
		</div>
		<div class="hero-content">
			<h1 class="hero-title">
				Trouvez votre bouchon<br class="mobile-br"> lyonnais idéal
			</h1>
			<p class="hero-subtitle">
				Une sélection préparée par des experts,<br> des résultats adaptés à vos critères.
			</p>
		</div>
	</div>
</header>

<style>
	* {
		box-sizing: border-box;
	}

	.hero-header {
		background: linear-gradient(135deg, #f0c6da 0%, rgba(240, 198, 218, 0.8) 100%);
		color: #221f20;
		padding: 2rem 0 1rem;
		width: 100%;
		max-width: 100vw;
		overflow: hidden;
	}

	.hero-container {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0 2rem;
		width: 100%;
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		gap: 2rem;
		align-items: center;
		overflow: hidden;
	}

	.logo {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.logo-image {
		width: 115px;
		object-fit: contain;
		transition: transform 0.3s ease;
	}

	.logo-image:hover {
		transform: scale(1.05);
	}

	.hero-content {
		text-align: center;
		min-width: 0;
		position: relative;
		left: -150px;
		width: calc(100% + 150px);
		box-sizing: border-box;
	}

	.hero-title {
		font-family: 'GiltonRegular', 'Playfair Display', serif;
		font-size: 36px;
		color: #221f20;
		font-weight: normal;
		margin: 0 0 1rem;
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	.hero-subtitle {
		font-family: 'Open Sans', Arial, sans-serif;
		font-size: 20px;
		color: #221f20;
		opacity: 0.8;
		margin: 0 auto;
		max-width: 600px;
	}

	.mobile-br {
		display: none;
	}

	@media (min-width: 1200px) {
		.hero-header {
			padding: 1.5rem 0 1rem;
		}

		.hero-container {
			padding: 2rem;
		}
	}

	@media (max-width: 980px) {
		.hero-header {
			padding: 1.5rem 0 1rem;
		}

		.hero-container {
			padding: 1.5rem 2rem;
			grid-template-columns: 1fr;
			gap: 1.5rem;
			overflow: visible;
		}

		.logo {
			width: 100%;
			justify-self: center;
		}

		.logo-image {
			width: 80px;
		}

		.hero-content {
			position: static;
			left: 0;
			width: 100%;
			max-width: none;
			justify-self: stretch;
			text-align: center;
			padding: 0;
			margin: 0 auto;
		}

		.hero-title {
			font-size: 32px;
		}

		.hero-subtitle {
			font-size: 18px;
		}
	}

	@media (max-width: 600px) {
		.hero-header {
			padding: 0 0 0.5rem;
			max-width: 100vw;
		}

		.hero-container {
			padding: 1rem 1rem;
			gap: 0.75rem;
			max-width: 100%;
			width: 100%;
		}

		.logo {
			justify-self: center;
		}

		.logo-image {
			width: 60px;
		}

		.hero-content {
			position: static;
			left: 0;
			width: 100%;
			max-width: none;
			justify-self: stretch;
			text-align: center;
			padding: 0;
			margin: 0 auto;
		}

		.hero-title {
			font-size: 24px;
			margin: 0rem;
		}

		.hero-subtitle {
			font-size: 16px;
			max-width: 100%;
		}

		.mobile-br {
			display: inline;
		}
	}
</style>