---
---

<header class="hero-header">
	<div class="hero-container">
		<nav class="hero-nav">
			<div class="logo">
				<img src="/favicon.ico" alt="Logo cochon" class="logo-cochon">
				<h1>Mon Bouchon</h1>
			</div>
		</nav>
		
		<div class="hero-content">
			<h2>Trouvez votre bouchon lyonnais idéal</h2>
			<p class="hero-subtitle">Une sélection préparée par des experts, des résultats adaptés à vos critères.</p>
		</div>
	</div>
</header>

<style>
	/* Hero Header unifié */
	.hero-header {
		background: linear-gradient(135deg, #f0c6da 0%, rgba(240, 198, 218, 0.8) 100%);
		display: flex;
		align-items: flex-start;
		color: #221f20;
		position: relative;
		padding: 2rem 0 1rem 0;
		width: 100%;
	}

	.hero-container {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0rem 2rem;
		width: 100%;
	}

	/* Navigation intégrée */
	.hero-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 3rem;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.logo-cochon {
		height: 50px;
		width: 50px;
		object-fit: contain;
		image-rendering: -webkit-optimize-contrast;
		image-rendering: crisp-edges;
		border-radius: 50%;
		background-color: rgba(255, 255, 255, 0.2);
		padding: 8px;
		transition: all 0.3s ease;
	}

	.logo-cochon:hover {
		background-color: rgba(255, 255, 255, 0.3);
		transform: scale(1.05);
	}

	.logo h1 {
		font-family: 'GiltonRegular', 'Playfair Display', serif;
		font-size: 36px;
		color: #221f20;
		margin: 0;
		padding: 0;
		font-weight: normal;
	}


	/* Contenu hero */
	.hero-content {
		text-align: center;
	}

	.hero-content h2 {
		font-family: 'GiltonRegular', 'Playfair Display', serif;
		font-size: 48px;
		font-weight: normal;
		color: #221f20;
		margin-bottom: 1.5rem;
		line-height: 1.2;
	}

	.hero-subtitle {
		font-family: 'Open Sans', Arial, sans-serif;
		font-size: 20px;
		color: #221f20;
		opacity: 0.8;
		margin-bottom: 2.5rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}


	/* Desktop large screens */
	@media (min-width: 1200px) {
		.hero-header {
			padding: 1.5rem 0 1rem 0;
		}

		.hero-container {
			padding: 2rem 2rem;
		}
	}

	@media (max-width: 980px) {
		.hero-header {
			padding: 1.5rem 0 1rem 0;
		}

		.hero-container {
			padding: 1.5rem 1rem;
		}

		.hero-nav {
			margin-bottom: 2rem;
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}


		.logo h1 {
			font-size: 32px;
		}

		.logo-cochon {
			height: 45px;
			width: 45px;
			padding: 6px;
		}

		.hero-content h2 {
			font-size: 36px;
		}

		.hero-subtitle {
			font-size: 18px;
			margin-bottom: 2rem;
		}

	}

	@media (max-width: 600px) {
		.hero-header {
			padding: 1rem 0 0.5rem 0;
		}

		.hero-content h2 {
			font-size: 30px;
		}

		.hero-subtitle {
			font-size: 16px;
			margin-bottom: 1.5rem;
		}


		.logo h1 {
			font-size: 28px;
		}

		.logo-cochon {
			height: 40px;
			width: 40px;
			padding: 5px;
		}
	}
</style>