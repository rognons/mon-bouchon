---
// biome-ignore lint/correctness/noUnusedImports: Used in template below
import BouchonSearch from '../components/BouchonSearch.svelte';
// biome-ignore lint/correctness/noUnusedImports: Used in template below
import Footer from '../components/Footer.astro';
// biome-ignore lint/correctness/noUnusedImports: Used in template below
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mon Bouchon | La Compagnie du Rognon</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400&display=swap" rel="stylesheet">
		<!-- Police GiltonRegular officielle -->
		<style>
			@font-face {
				font-family: 'GiltonRegular';
				src: url('/fonts/giltonregular-gom7d.otf') format('opentype');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}
		</style>
	</head>
	<body>
		<main>
			<Header />
			
			<section id="recherche" class="search-section">
				<BouchonSearch client:load />
			</section>
		</main>

		<Footer />

		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				width: 100%;
				overflow-x: hidden;
			}

			body {
				font-family: 'Open Sans', Arial, sans-serif;
				font-size: 14px;
				color: #666;
				background-color: #fff;
				line-height: 1.7em;
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				margin: 0;
				padding: 0;
				width: 100%;
				overflow-x: hidden;
			}

		main {
			background-color: #fff;
			margin: 0;
			padding: 0;
			width: 100%;
			overflow-x: hidden;
		}			/* Section recherche */
			.search-section {
				padding: 1.5rem 2rem 3rem 2rem;
				background-color: #fff;
				max-width: 1400px;
				margin: 0 auto;
			}

			/* Styles globaux pour les liens comme sur compagnie-du-rognon.fr */
			:global(a) {
				color: #f0c6da;
				text-decoration: none;
			}

			:global(a:hover) {
				color: #f0c6da;
				opacity: 0.7;
				transition: all 0.4s ease-in-out;
			}

			/* Styles pour les titres */
			:global(h1), :global(h2), :global(h3), :global(h4), :global(h5), :global(h6) {
				color: #221f20;
				padding-bottom: 10px;
				line-height: 1em;
				font-weight: normal;
				font-family: 'GiltonRegular', 'Playfair Display', serif;
			}

			:global(h1) { font-size: 30px; }
			:global(h2) { font-size: 26px; }
			:global(h3) { font-size: 22px; }
			:global(h4) { font-size: 18px; }
			:global(h5) { font-size: 16px; }
			:global(h6) { font-size: 14px; }

			@media (max-width: 768px) {
				.search-section {
					padding: 1rem 1.5rem 3rem 1.5rem;
				}
			}

			@media (max-width: 600px) {
				.search-section {
					padding: 0.5rem 1rem 2rem 1rem;
				}
			}
		</style>
	</body>
</html>
