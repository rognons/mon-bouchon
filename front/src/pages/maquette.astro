---
// biome-ignore lint/correctness/noUnusedImports: Used in template below
import Maquette from '../components/Maquette.svelte';
// biome-ignore lint/correctness/noUnusedImports: Used in template below
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<!-- Zoom bloqué à la demande du projet (moins accessible : WCAG 1.4.4). -->
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>Mon Bouchon | La Compagnie du Rognon</title>
		<!-- Une seule adresse pour Google, avec ou sans « www » ni paramètres. -->
		<link rel="canonical" href="https://mon-bouchon.fr/" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..700&display=swap" rel="stylesheet">
		<!-- Police GiltonRegular officielle -->
		<style>
			@font-face {
				font-family: 'GiltonRegular';
				src: url('/fonts/giltonregular-gom7d.otf') format('opentype');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}
		</style>
	</head>
	<body>
		<main>
			<Maquette client:load />
		</main>

		<Footer />

		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				width: 100%;
				overflow-x: clip;
				/* Pas de zoom au double appui. */
				touch-action: manipulation;
			}

			body {
				font-family: 'Open Sans', Arial, sans-serif;
				font-size: 14px;
				color: #666;
				background-color: #fff;
				line-height: 1.7em;
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				margin: 0;
				padding: 0;
				width: 100%;
				overflow-x: clip;
			}

		main {
			background-color: #fff;
			margin: 0;
			padding: 0;
			width: 100%;
			overflow-x: clip;
		}

			/* Styles globaux pour les liens comme sur compagnie-du-rognon.fr */
			:global(a) {
				color: #f0c6da;
				text-decoration: none;
			}

			:global(a:hover) {
				color: #f0c6da;
				opacity: 0.7;
				transition: all 0.4s ease-in-out;
			}

			/* Styles pour les titres */
			:global(h1), :global(h2), :global(h3), :global(h4), :global(h5), :global(h6) {
				color: #221f20;
				padding-bottom: 10px;
				line-height: 1em;
				font-weight: normal;
				font-family: 'GiltonRegular', 'Playfair Display', serif;
			}

			:global(h1) { font-size: 30px; }
			:global(h2) { font-size: 26px; }
			:global(h3) { font-size: 22px; }
			:global(h4) { font-size: 18px; }
			:global(h5) { font-size: 16px; }
			:global(h6) { font-size: 14px; }
		</style>
	</body>
</html>
