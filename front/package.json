{
  "name": "front",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "lint": "biome lint src/ && npm run typecheck",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "svelte-check --no-tsconfig && astro check",
    "quality": "npm run format:check && npm run lint",
    "fix": "npm run format && npm run lint:fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/svelte": "^7.2.4",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^5.16.6",
    "svelte": "^5.46.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
