    "fix": "npm run format && npm run lint:fix"
  },
  "dependencies": {
    "@astrojs/svelte": "^7.2.0",
    "astro": "^5.14.6",
    "svelte": "^5.41.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6"
  }
}
