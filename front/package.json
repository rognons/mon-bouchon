{
  "name": "front",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
