{
  "name": "api",
  "version": "1.0.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --allow-net --allow-read --watch-hmr main.ts",
    "start": "deno run --allow-net --allow-read main.ts",
    "test": "deno test --allow-net --allow-read",
    "lint": "deno lint && deno task check",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/**/*.ts main.ts",
    "quality": "deno task lint && deno task fmt:check",
    "fix": "deno task fmt && deno task lint",
    "update-bouchons-google": "deno run --allow-net --allow-read --allow-write --allow-env src/scripts/update_bouchons_google.ts"
  },
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17.1.0",
    "@std/http": "jsr:@std/http@^1.0.8",
    "@std/json": "jsr:@std/json@^1.0.1",
    "cors": "https://deno.land/x/cors@v1.2.2/mod.ts"
  }
}
