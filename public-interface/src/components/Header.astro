---
export interface Props {
	totalBouchons: number;
	uniqueArrondissements: number;
	criteriaCount: number;
}

const { totalBouchons, uniqueArrondissements, criteriaCount } = Astro.props;
---

<header class="hero-header">
	<div class="hero-container">
		<nav class="hero-nav">
			<div class="logo">
				<img src="/favicon.ico" alt="Logo cochon" class="logo-cochon">
				<h1>Mon Bouchon</h1>
			</div>
			<div class="hero-tagline">
				<span>L'authentique tradition lyonnaise</span>
			</div>
		</nav>
		
		<div class="hero-content">
			<h2>Découvrez les vrais bouchons de Lyon</h2>
			<p class="hero-subtitle">Trouvez le bouchon parfait selon vos envies, votre budget et vos critères</p>
			
			<div class="hero-stats">
				<div class="stat">
					<span class="stat-number">{totalBouchons}</span>
					<span class="stat-label">Bouchons référencés</span>
				</div>
				<div class="stat">
					<span class="stat-number">{uniqueArrondissements}</span>
					<span class="stat-label">Arrondissements</span>
				</div>
				<div class="stat">
					<span class="stat-number">{criteriaCount}</span>
					<span class="stat-label">Critères de recherche</span>
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	/* Hero Header unifié */
	.hero-header {
		background: linear-gradient(135deg, #f0c6da 0%, rgba(240, 198, 218, 0.8) 100%);
		min-height: 42vh;
		display: flex;
		align-items: flex-start;
		color: #221f20;
		position: relative;
		padding: 2rem 0 1rem 0;
		width: 100%;
	}

	.hero-container {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0rem 2rem;
		width: 100%;
		overflow-x: hidden;
	}

	/* Navigation intégrée */
	.hero-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 3rem;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.logo-cochon {
		height: 50px;
		width: 50px;
		object-fit: contain;
		image-rendering: -webkit-optimize-contrast;
		image-rendering: crisp-edges;
		border-radius: 50%;
		background-color: rgba(255, 255, 255, 0.2);
		padding: 8px;
		transition: all 0.3s ease;
	}

	.logo-cochon:hover {
		background-color: rgba(255, 255, 255, 0.3);
		transform: scale(1.05);
	}

	.logo h1 {
		font-family: 'GiltonRegular', 'Playfair Display', serif;
		font-size: 36px;
		color: #221f20;
		margin: 0;
		padding: 0;
		font-weight: normal;
	}

	.hero-tagline {
		text-align: right;
	}

	.hero-tagline span {
		font-family: 'Open Sans', Arial, sans-serif;
		font-size: 14px;
		color: #221f20;
		opacity: 0.8;
		font-style: italic;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	/* Contenu hero */
	.hero-content {
		text-align: center;
	}

	.hero-content h2 {
		font-family: 'GiltonRegular', 'Playfair Display', serif;
		font-size: 48px;
		font-weight: normal;
		color: #221f20;
		margin-bottom: 1.5rem;
		line-height: 1.2;
	}

	.hero-subtitle {
		font-family: 'Open Sans', Arial, sans-serif;
		font-size: 20px;
		color: #221f20;
		opacity: 0.8;
		margin-bottom: 2.5rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.hero-stats {
		display: flex;
		justify-content: center;
		gap: 4rem;
		margin-top: 2rem;
	}

	.stat {
		text-align: center;
	}

	.stat-number {
		display: block;
		font-family: 'GiltonRegular', 'Playfair Display', serif;
		font-size: 36px;
		color: #221f20;
		font-weight: normal;
		margin-bottom: 0.5rem;
	}

	.stat-label {
		font-family: 'Open Sans', Arial, sans-serif;
		font-size: 12px;
		color: #221f20;
		opacity: 0.7;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	/* Desktop large screens */
	@media (min-width: 1200px) {
		.hero-header {
			min-height: 40vh;
			padding: 1.5rem 0 1rem 0;
		}

		.hero-container {
			padding: 2rem 2rem;
		}
	}

	@media (max-width: 980px) {
		.hero-header {
			min-height: 50vh;
			padding: 1.5rem 0 1rem 0;
		}

		.hero-container {
			padding: 1.5rem 1rem;
		}

		.hero-nav {
			margin-bottom: 2rem;
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}

		.hero-tagline {
			text-align: center;
		}

		.logo h1 {
			font-size: 32px;
		}

		.logo-cochon {
			height: 45px;
			width: 45px;
			padding: 6px;
		}

		.hero-content h2 {
			font-size: 36px;
		}

		.hero-subtitle {
			font-size: 18px;
			margin-bottom: 2rem;
		}

		.hero-stats {
			gap: 2rem;
			flex-wrap: wrap;
		}

		.stat-number {
			font-size: 30px;
		}

		.stat-label {
			font-size: 11px;
		}
	}

	@media (max-width: 600px) {
		.hero-header {
			min-height: 50vh;
			padding: 1rem 0 0.5rem 0;
		}

		.hero-content h2 {
			font-size: 30px;
		}

		.hero-subtitle {
			font-size: 16px;
			margin-bottom: 1.5rem;
		}

		.hero-stats {
			flex-direction: column;
			gap: 1.5rem;
		}

		.logo h1 {
			font-size: 28px;
		}

		.logo-cochon {
			height: 40px;
			width: 40px;
			padding: 5px;
		}
	}
</style>